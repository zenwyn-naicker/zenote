             Width="30" Height="30">
  <Border CornerRadius="8" Background="{StaticResource TextBrush}">
    <Viewbox Margin="7,7,6,5">
      <Canvas Width="24" Height="25">
        <Path Fill="White" Data="M3 0H14.5L24 9.5V17A3 3 0 0 1 21 20H10L4.6 24.3C3.9 24.9 3 24.4 3 23.5V20A3 3 0 0 1 0 17V3A3 3 0 0 1 3 0Z" />
        <Path Fill="#9AA0A6" Data="M14.5 0L24 9.5H16.5A2 2 0 0 1 14.5 7.5Z" />
      </Canvas>
    </Viewbox>
  </Border>
</UserControl>
