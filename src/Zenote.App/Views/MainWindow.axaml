<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Zenote.App.ViewModels"
        xmlns:views="using:Zenote.App.Views"
        x:Class="Zenote.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Zenote"
        Icon="avares://Zenote/Assets/icon.png"
        Width="1280" Height="820" MinWidth="880" MinHeight="560"
        Background="{StaticResource PageBrush}">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:NotebooksViewModel">
      <views:NotebooksView />
    </DataTemplate>
    <DataTemplate DataType="vm:NotebookViewModel">
      <views:NotebookView />
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasProblems}" Background="#FEF7E0" Padding="20,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="pill" Height="30" Content="Check again" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding ProblemText}" FontSize="13" Foreground="#7A4F01" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <Panel>
      <ContentControl Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

      <Button Classes="icon" Command="{Binding Settings.OpenCommand}" ToolTip.Tip="Settings"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0">
        <PathIcon Data="{StaticResource IconSettings}" />
      </Button>

      <Border IsVisible="{Binding Settings.IsOpen}" Background="#59000000">
        <Border DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"
                Background="{StaticResource SurfaceBrush}" CornerRadius="20" Padding="28,22,28,20" Width="500"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding CloseCommand}" ToolTip.Tip="Close settings" Margin="0,0,-8,0">
                <PathIcon Data="{StaticResource IconClose}" />
              </Button>
              <TextBlock Text="Settings" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel>
              <ComboBox DockPanel.Dock="Right" Classes="field" ItemsSource="{Binding ModelPicker.Models}" SelectedItem="{Binding ModelPicker.Selected}"
                        IsVisible="{Binding IsConnected}" VerticalAlignment="Center" ToolTip.Tip="Chat model" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Chat model" FontSize="14" FontWeight="Medium" />
                <TextBlock Text="Writes your answers. Changes apply to your next question." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding SearchModel}" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Search model" FontSize="14" FontWeight="Medium" />
                <TextBlock Text="Finds the passages in your sources that answers are based on." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <Border Height="1" Background="{StaticResource LineBrush}" />

            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#1E8E3E" IsVisible="{Binding IsConnected}" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ConnectionText}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
              <TextBlock Text="Ollama" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>

            <Border Height="1" Background="{StaticResource LineBrush}" />

            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="pill" Height="32" Content="Show in Finder" Command="{Binding ShowDataFolderCommand}" VerticalAlignment="Center" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Your data" FontSize="14" FontWeight="Medium" />
                <TextBlock Text="Notebooks and PDFs stay on this Mac." FontSize="12" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
            </DockPanel>

          </StackPanel>
        </Border>
      </Border>
    </Panel>
  </DockPanel>
</Window>
