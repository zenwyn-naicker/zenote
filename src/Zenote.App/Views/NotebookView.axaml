<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Zenote.App.ViewModels"
             xmlns:views="using:Zenote.App.Views"
             xmlns:converters="using:Zenote.App.Converters"
             x:Class="Zenote.App.Views.NotebookView"
             x:DataType="vm:NotebookViewModel"
             DragDrop.AllowDrop="True">
  <UserControl.Resources>
    <converters:BytesToBitmapConverter x:Key="BytesToBitmap" />
  </UserControl.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E7E5E4" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="‹ Notebooks" Command="{Binding BackCommand}" FontSize="12" Padding="10,3" />
        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" IsVisible="{Binding HasMessage}" Background="#FEF3C7" Padding="16,8">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" Foreground="#78350F" />
    </Border>

    <Grid ColumnDefinitions="280,*,Auto">
      <Border Grid.Column="0" BorderBrush="#E7E5E4" BorderThickness="0,0,1,0" Background="#FAFAF9">
        <DockPanel Margin="12">
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
            <Button DockPanel.Dock="Right" Content="Add PDFs" Command="{Binding AddPdfsCommand}" FontSize="12" Padding="10,3" />
            <TextBlock Text="Sources" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

          <TextBlock DockPanel.Dock="Top" IsVisible="{Binding IsImporting}" Text="Reading PDF…"
                     FontSize="13" Foreground="#78716C" Margin="4,0,0,8" />

          <TextBlock DockPanel.Dock="Top" IsVisible="{Binding HasNoSources}" TextWrapping="Wrap" Margin="4,8"
                     FontSize="13" Foreground="#78716C" Text="Drop PDFs here, or use Add PDFs." />

          <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SourceItemViewModel">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DeleteCommand}" ToolTip.Tip="Remove source"
                          FontSize="11" Padding="6,1" Background="Transparent" VerticalAlignment="Top" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding FileName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#78716C" TextWrapping="Wrap" />
                    <ProgressBar IsVisible="{Binding IsIndexing}" Value="{Binding ProgressPercent}" Height="3" MinHeight="3" Margin="0,3" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button IsVisible="{Binding IsIndexing}" Content="Cancel" Command="{Binding CancelCommand}" FontSize="11" Padding="8,1" />
                      <Button IsVisible="{Binding CanRetry}" Content="Retry" Command="{Binding RetryCommand}" FontSize="11" Padding="8,1" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding LooksScanned}" FontSize="12" Foreground="#B45309" TextWrapping="Wrap"
                               Text="Looks scanned. Text search won't work." />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <views:ChatView Grid.Column="1" DataContext="{Binding Chat}" />

      <Border Grid.Column="2" Width="400" IsVisible="{Binding Panel.IsOpen}" BorderBrush="#E7E5E4" BorderThickness="1,0,0,0">
        <DockPanel DataContext="{Binding Panel}" x:DataType="vm:SourcePanelViewModel">
          <DockPanel DockPanel.Dock="Top" Margin="16,10">
            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Close"
                    FontSize="11" Padding="6,1" Background="Transparent" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>

          <DockPanel DockPanel.Dock="Bottom" IsVisible="{Binding HasDocument}" Margin="12,8">
            <Button DockPanel.Dock="Right" Content="Open in Preview" Command="{Binding OpenInPreviewCommand}" FontSize="11" Padding="8,2" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="‹" Command="{Binding PreviousPageCommand}" FontSize="12" Padding="8,1" ToolTip.Tip="Previous page" />
              <Button Content="›" Command="{Binding NextPageCommand}" FontSize="12" Padding="8,1" ToolTip.Tip="Next page" />
              <TextBlock Text="{Binding PageLabel}" FontSize="12" Foreground="#78716C" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
          </DockPanel>

          <Border DockPanel.Dock="Top" IsVisible="{Binding HasSnippet}" Background="#FEF9C3" Margin="12,0,12,8" Padding="10,8" CornerRadius="6" MaxHeight="150">
            <ScrollViewer>
              <SelectableTextBlock Text="{Binding Snippet}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
            </ScrollViewer>
          </Border>

          <TextBlock DockPanel.Dock="Top" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                     FontSize="12" Foreground="#78716C" Margin="16,4" TextWrapping="Wrap" />

          <ScrollViewer Background="#F5F5F4">
            <Image Source="{Binding PageImage, Converter={StaticResource BytesToBitmap}}" Margin="10" Stretch="Uniform" VerticalAlignment="Top" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
